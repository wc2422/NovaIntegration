@model List<NovaIntegration.Web.Models.Detection>

@using System.Globalization

@{
    ViewData["Title"] = "Detection Logs";

    int totalCount = Model?.Count ?? 0;

    int criticalCount =
        Model?.Count(detection =>
            string.Equals(
                detection.Severity,
                "Critical",
                StringComparison.OrdinalIgnoreCase
            )
        ) ?? 0;

    int highCount =
        Model?.Count(detection =>
            string.Equals(
                detection.Severity,
                "High",
                StringComparison.OrdinalIgnoreCase
            )
        ) ?? 0;

    int mediumCount =
        Model?.Count(detection =>
            string.Equals(
                detection.Severity,
                "Medium",
                StringComparison.OrdinalIgnoreCase
            )
        ) ?? 0;

    int lowCount =
        Model?.Count(detection =>
            string.Equals(
                detection.Severity,
                "Low",
                StringComparison.OrdinalIgnoreCase
            )
        ) ?? 0;

    int pendingCount =
        Model?.Count(detection =>
            string.Equals(
                detection.Status,
                "Pending",
                StringComparison.OrdinalIgnoreCase
            )
        ) ?? 0;

    int escalatedCount =
        Model?.Count(detection =>
            string.Equals(
                detection.Status,
                "Escalated",
                StringComparison.OrdinalIgnoreCase
            )
        ) ?? 0;

    int todayCount =
        Model?.Count(detection =>
            detection.DetectedAt.Date == DateTime.Today
        ) ?? 0;

    double averageConfidence =
        totalCount > 0
            ? Model.Average(detection => detection.Confidence)
            : 0;

    double criticalPercentage =
        totalCount > 0
            ? criticalCount * 100.0 / totalCount
            : 0;

    double highPercentage =
        totalCount > 0
            ? highCount * 100.0 / totalCount
            : 0;

    double mediumPercentage =
        totalCount > 0
            ? mediumCount * 100.0 / totalCount
            : 0;

    double criticalEnd = criticalPercentage;

    double highEnd =
        criticalPercentage +
        highPercentage;

    double mediumEnd =
        criticalPercentage +
        highPercentage +
        mediumPercentage;

    string criticalEndCss =
        criticalEnd.ToString(
            "0.##",
            CultureInfo.InvariantCulture
        );

    string highEndCss =
        highEnd.ToString(
            "0.##",
            CultureInfo.InvariantCulture
        );

    string mediumEndCss =
        mediumEnd.ToString(
            "0.##",
            CultureInfo.InvariantCulture
        );
}

