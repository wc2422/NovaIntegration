        border-top: 1px solid rgba(51, 65, 85, 0.34);
    }

    .pagination-information {
        color: #52677d;
        font-size: 7px;
    }

    .pagination-controls,
    .page-number-buttons {
        display: flex;
        gap: 6px;
    }

    .pagination-button,
    .page-number-button {
        min-width: 34px;
        padding: 6px 9px;
        border: 1px solid rgba(71, 85, 105, 0.55);
        background: rgba(15, 23, 42, 0.8);
        color: #73889e;
    }

        .page-number-button.active {
            border-color: #0284c7;
            background: #0284c7;
            color: #ffffff;
        }

        .pagination-button:disabled {
            opacity: 0.35;
            cursor: default;
            transform: none;
        }

    .detection-modal {
        position: fixed;
        inset: 0;
        z-index: 7000;
        display: none;
    }

        .detection-modal.open {
            display: block;
        }

    .detection-modal-overlay {
        position: absolute;
        inset: 0;
        background: rgba(1, 6, 15, 0.86);
        backdrop-filter: blur(9px);
    }

    .detection-modal-dialog {
        position: relative;
        z-index: 2;
        width: min(930px, calc(100% - 30px));
        max-height: 92vh;
        margin: 4vh auto;
        overflow-y: auto;
        border: 1px solid rgba(56, 189, 248, 0.24);
        border-radius: 16px;
        background: linear-gradient( 145deg, #0d1728, #070e19 );
        box-shadow: 0 30px 90px rgba(0, 0, 0, 0.62);
    }

    .detection-modal-header,
    .detection-modal-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
        padding: 18px 20px;
        border-bottom: 1px solid rgba(51, 65, 85, 0.42);
    }

        .detection-modal-header h2 {
            margin: 5px 0 0;
            color: #f1f5f9;
            font-size: 18px;
        }

    .modal-close-button {
        width: 36px;
        padding: 0;
        border: 1px solid rgba(71, 85, 105, 0.55);
        background: rgba(15, 23, 42, 0.82);
        color: #64748b;
        font-size: 18px;
    }

    .detection-modal-body {
        padding: 20px;
    }

    .modal-camera-preview {
        position: relative;
        height: 300px;
        overflow: hidden;
        border: 1px solid rgba(56, 189, 248, 0.34);
        border-radius: 12px;
        background: radial-gradient( circle at 50% 55%, #1d3650, #07101b 72% );
    }

    .preview-grid-overlay {
        position: absolute;
        inset: 0;
        background-image: linear-gradient( rgba(56, 189, 248, 0.06) 1px, transparent 1px ), linear-gradient( 90deg, rgba(56, 189, 248, 0.06) 1px, transparent 1px );
        background-size: 32px 32px;
    }

    .preview-detection-box {
        position: absolute;
        top: 50%;
        left: 50%;
        width: 145px;
        height: 175px;
        border: 1px solid #22d3ee;
        transform: translate(-50%, -50%);
        box-shadow: 0 0 20px rgba(34, 211, 238, 0.18);
    }

        .preview-detection-box span {
            position: absolute;
            top: 100%;
            left: 0;
            margin-top: 6px;
            padding: 5px 7px;
            border-radius: 4px;
            background: rgba(3, 8, 16, 0.78);
            color: #67e8f9;
            font-family: Consolas, monospace;
            font-size: 7px;
            white-space: nowrap;
        }

    .preview-live-label,
    .preview-camera-label {
        position: absolute;
        top: 13px;
        z-index: 3;
        padding: 6px 8px;
        border-radius: 5px;
        background: rgba(3, 8, 16, 0.76);
        font-family: Consolas, monospace;
        font-size: 7px;
    }

    .preview-live-label {
        left: 13px;
        color: #fb7185;
    }

        .preview-live-label span {
            display: inline-block;
            width: 6px;
            height: 6px;
            margin-right: 5px;
            border-radius: 50%;
            background: #f43f5e;
        }

    .preview-camera-label {
        right: 13px;
        color: #7dd3fc;
    }

    .preview-placeholder {
        position: absolute;
        right: 0;
        bottom: 12px;
        left: 0;
        color: #3e5369;
        font-size: 8px;
        letter-spacing: 1px;
        text-align: center;
    }

    .modal-detail-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 10px;
        margin-top: 14px;
    }

    .modal-detail-item,
    .modal-notes-panel,
    .modal-status-control {
        padding: 11px;
        border: 1px solid rgba(51, 65, 85, 0.42);
        border-radius: 8px;
        background: rgba(10, 19, 32, 0.78);
    }

        .modal-detail-item span,
        .modal-detail-item strong {
            display: block;
        }

        .modal-detail-item span,
        .modal-notes-panel span,
        .modal-status-control label {
            color: #52677f;
            font-size: 7px;
            text-transform: uppercase;
        }

        .modal-detail-item strong {
            margin-top: 5px;
            overflow: hidden;
            color: #cbd5e1;
            font-size: 8px;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

    .modal-notes-panel,
    .modal-status-control {
        margin-top: 10px;
    }

        .modal-notes-panel p {
            margin: 7px 0 0;
            color: #91a5b9;
            font-size: 8px;
            line-height: 1.6;
        }

        .modal-status-control select {
            display: block;
            margin-top: 7px;
        }

    .detection-modal-footer {
        justify-content: flex-end;
        border-top: 1px solid rgba(51, 65, 85, 0.42);
        border-bottom: 0;
    }

    body.modal-open {
        overflow: hidden;
    }

    .detection-toast {
        position: fixed;
        right: 25px;
        bottom: 25px;
        z-index: 8000;
        display: flex;
        min-width: 300px;
        align-items: center;
        gap: 10px;
        padding: 13px 15px;
        border: 1px solid rgba(34, 197, 94, 0.28);
        border-radius: 10px;
        background: linear-gradient( 135deg, rgba(4, 47, 30, 0.96), rgba(6, 24, 30, 0.96) );
        color: #bbf7d0;
        font-size: 9px;
        box-shadow: 0 18px 45px rgba(0, 0, 0, 0.42);
        opacity: 0;
        transform: translateY(20px);
        pointer-events: none;
        transition: opacity 0.2s ease, transform 0.2s ease;
    }

        .detection-toast.show {
            opacity: 1;
            transform: translateY(0);
        }

    .toast-icon {
        display: flex;
        width: 25px;
        height: 25px;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: #22c55e;
        color: #ffffff;
    }

    @@media (max-width: 1280px) {
        .logs-intelligence-grid {
            grid-template-columns: 1fr;
        }

        .logs-filter-grid {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }

        .logs-search-box {
            grid-column: span 3;
        }
    }

    @@media (max-width: 900px) {
        .logs-page-heading {
            flex-direction: column;
        }

        .logs-summary-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .modal-detail-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 650px) {
        .logs-summary-grid,
        .logs-filter-grid,
        .modal-detail-grid,
        .risk-layout {
            grid-template-columns: 1fr;
        }

        .logs-search-box {
            grid-column: auto;
        }

        .logs-status-banner,
        .records-header,
        .logs-pagination {
            align-items: flex-start;
            flex-direction: column;
        }

        .risk-layout {
            justify-items: center;
        }

        .logs-heading-actions {
            width: 100%;
        }

            .logs-heading-actions button {
                flex: 1;
            }

        .detection-toast {
            right: 14px;
            bottom: 14px;
            left: 14px;
            min-width: 0;
        }
    }
</style>

<section class="advanced-logs-page">

    <header class="logs-page-heading">

        <div>

            <span class="page-eyebrow">
                SECURITY OPERATIONS CENTRE
            </span>

            <h1>AI Detection Logs</h1>

            <p>
                Monitor, investigate and review AI-generated security
                detections across all connected surveillance cameras.
            </p>

        </div>

        <div class="logs-heading-actions">

            <button type="button"
                    class="secondary-action-button"
                    onclick="refreshDetectionLogs()">
                ↻ Refresh
            </button>

            <button type="button"
                    class="primary-action-button"
                    onclick="exportDetectionLogs()">
                ⇩ Export CSV
            </button>

        </div>

    </header>

    <section class="logs-status-banner">

        <div class="logs-status-left">

            <span class="logs-live-indicator"></span>

            <div>

                <strong>
                    Live detection monitoring is active
                </strong>

                <small>
                    Last synchronisation:
                    <span id="lastSyncTime">
                        @DateTime.Now.ToString("hh:mm:ss tt")
                    </span>
                </small>

            </div>

        </div>

        <div class="logs-system-health">

            <span>System health</span>

            <strong>98.7%</strong>

        </div>

    </section>

    <section class="logs-summary-grid">

        <article class="logs-summary-card">

            <div class="summary-card-icon summary-icon-blue">
                ◎
            </div>

            <div class="summary-card-content">

                <span>Total detections</span>

                <strong>@totalCount</strong>

                <small>
                    @todayCount recorded today
                </small>

            </div>

        </article>

        <article class="logs-summary-card">

            <div class="summary-card-icon summary-icon-red">
                !
            </div>

            <div class="summary-card-content">

                <span>Critical events</span>

                <strong>@criticalCount</strong>

                <small>
                    Require immediate review
                </small>

            </div>

        </article>

        <article class="logs-summary-card">

            <div class="summary-card-icon summary-icon-orange">
                ◷
            </div>

            <div class="summary-card-content">

                <span>Pending review</span>

                <strong>@pendingCount</strong>

                <small>
                    @escalatedCount escalated events
                </small>

            </div>

        </article>

        <article class="logs-summary-card">

            <div class="summary-card-icon summary-icon-green">
                %
            </div>

            <div class="summary-card-content">

                <span>Average confidence</span>

                <strong>
                    @averageConfidence.ToString("0.0")%
                </strong>

                <small>
                    Across all AI detections
                </small>

            </div>

        </article>

    </section>

    <section class="logs-intelligence-grid">

        <article class="logs-panel">

            <header class="panel-header">

                <div>

                    <span class="panel-eyebrow">
                        RISK ANALYSIS
                    </span>

                    <h2>Severity Distribution</h2>

                </div>

                <span class="live-label">
                    LIVE
                </span>

            </header>

            <div class="risk-layout">

                <div class="risk-donut"
                     style="
                        --critical: @criticalEndCss%;
                        --high: @highEndCss%;
                        --medium: @mediumEndCss%;
                     ">

                    <div class="risk-donut-centre">

                        <strong>@totalCount</strong>

                        <span>Events</span>

                    </div>

                </div>

                <div class="risk-list">

                    <div class="risk-item">

                        <div class="risk-item-heading">

                            <span>
                                <i class="risk-dot risk-critical"></i>
                                Critical
                            </span>

                            <strong>@criticalCount</strong>

                        </div>

                        <div class="risk-track">

                            <div class="risk-fill risk-fill-critical"
                                 style="width: @criticalPercentage.ToString("0.##", CultureInfo.InvariantCulture)%">
                            </div>

                        </div>

                    </div>

                    <div class="risk-item">

                        <div class="risk-item-heading">

                            <span>
                                <i class="risk-dot risk-high"></i>
                                High
                            </span>

                            <strong>@highCount</strong>

                        </div>

                        <div class="risk-track">

                            <div class="risk-fill risk-fill-high"
                                 style="width: @highPercentage.ToString("0.##", CultureInfo.InvariantCulture)%">
                            </div>

                        </div>

                    </div>

                    <div class="risk-item">

                        <div class="risk-item-heading">

                            <span>
                                <i class="risk-dot risk-medium"></i>
                                Medium
                            </span>

                            <strong>@mediumCount</strong>

                        </div>

                        <div class="risk-track">

                            <div class="risk-fill risk-fill-medium"
                                 style="width: @mediumPercentage.ToString("0.##", CultureInfo.InvariantCulture)%">
                            </div>

                        </div>

                    </div>

                    <div class="risk-item">

                        <div class="risk-item-heading">

                            <span>
                                <i class="risk-dot risk-low"></i>
                                Low
                            </span>

                            <strong>@lowCount</strong>

                        </div>

                        <div class="risk-track">

                            <div class="risk-fill risk-fill-low"
                                 style="width: @(totalCount > 0 ? (lowCount * 100.0 / totalCount).ToString("0.##", CultureInfo.InvariantCulture) : "0")%">
                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </article>

        <article class="logs-panel">

            <header class="panel-header">

                <div>

                    <span class="panel-eyebrow">
                        REAL-TIME STREAM
                    </span>

                    <h2>Latest Event Feed</h2>

                </div>

                <span class="live-label">
                    CONNECTED
                </span>

            </header>

            <div id="liveEventFeed"
                 class="live-event-feed">

                @foreach (var detection in Model.Take(6))
                {
                    string eventSeverity =
                    string.IsNullOrWhiteSpace(detection.Severity)
                    ? "low"
                    : detection.Severity.ToLowerInvariant();

                    <div class="live-event-item">

                        <span class="event-severity-line event-@eventSeverity">
                        </span>

                        <div class="event-feed-content">

                            <strong>
                                @detection.AlertType
                            </strong>

                            <small>
                                @detection.CameraCode ·
                                @detection.Location
                            </small>

                        </div>

                        <time>
                            @detection.DetectedAt.ToString("HH:mm:ss")
                        </time>

                    </div>
                }

            </div>

        </article>

    </section>

    <section class="logs-panel records-panel">

        <header class="records-header">

            <div>

                <h2>Detection Records</h2>

                <p>
                    Search, filter and investigate recorded security events.
                </p>

            </div>

            <span class="record-count-label">
                <span id="visibleRecordCount">
                    @totalCount
                </span>
                records
            </span>

        </header>

        <div class="logs-filter-grid">

            <div class="logs-search-box">

                <span class="search-symbol">
                    ⌕
                </span>

                <input id="detectionSearch"
                       type="search"
                       placeholder="Search ID, camera, location, object or officer..."
                       oninput="applyDetectionFilters()" />

            </div>

            <select id="cameraFilter"
                    onchange="applyDetectionFilters()">

                <option value="">
                    All cameras
                </option>

                @foreach (
                                string camera in Model
                                .Where(detection =>
                                !string.IsNullOrWhiteSpace(
                                detection.CameraName
                                )
                                )
                                .Select(detection =>
                                detection.CameraName
                                )
                                .Distinct()
                                .OrderBy(camera => camera)
                                )
                {
                    <option value="@camera.ToLowerInvariant()">
                        @camera
                    </option>
                }

            </select>

            <select id="objectFilter"
                    onchange="applyDetectionFilters()">

                <option value="">
                    All objects
                </option>

                @foreach (
                                string objectType in Model
                                .Where(detection =>
                                !string.IsNullOrWhiteSpace(
                                detection.ObjectType
                                )
                                )
                                .Select(detection =>
                                detection.ObjectType
                                )
                                .Distinct()
                                .OrderBy(objectType => objectType)
                                )
                {
                    <option value="@objectType.ToLowerInvariant()">
                        @objectType
                    </option>
                }

            </select>

            <select id="severityFilter"
                    onchange="applyDetectionFilters()">

                <option value="">
                    All severities
                </option>

                <option value="critical">
                    Critical
                </option>

                <option value="high">
                    High
                </option>

                <option value="medium">
                    Medium
                </option>

                <option value="low">
                    Low
                </option>

            </select>

            <select id="statusFilter"
                    onchange="applyDetectionFilters()">

                <option value="">
                    All statuses
                </option>

                <option value="pending">
                    Pending
                </option>

                <option value="reviewed">
                    Reviewed
                </option>

                <option value="escalated">
                    Escalated
                </option>

                <option value="resolved">
                    Resolved
                </option>

            </select>

            <select id="dateFilter"
                    onchange="applyDetectionFilters()">

                <option value="">
                    Any time
                </option>

                <option value="today">
                    Today
                </option>

                <option value="24hours">
                    Last 24 hours
                </option>

                <option value="7days">
                    Last 7 days
                </option>

            </select>

            <button type="button"
                    class="clear-filter-button"
                    onclick="clearDetectionFilters()">
                Clear filters
            </button>

        </div>

        <div class="logs-table-wrapper">

            <table id="detectionLogsTable"
                   class="advanced-logs-table">

                <thead>

                    <tr>
                        <th>Detection</th>
                        <th>Camera and location</th>
                        <th>Object</th>
                        <th>Confidence</th>
                        <th>Risk</th>
                        <th>Status</th>
                        <th>AI model</th>
                        <th>Assigned officer</th>
                        <th>Detected</th>
                        <th>Action</th>
                    </tr>

                </thead>

                <tbody>

                    @foreach (var detection in Model)
                    {
                        string severity =
                        string.IsNullOrWhiteSpace(
                        detection.Severity
                        )
                        ? "Low"
                        : detection.Severity;

                        string status =
                        string.IsNullOrWhiteSpace(
                        detection.Status
                        )
                        ? "Pending"
                        : detection.Status;

                        string severityClass =
                        severity.ToLowerInvariant();

                        string statusClass =
                        status.ToLowerInvariant();

                        string cameraName =
                        detection.CameraName ?? "";

                        string objectType =
                        detection.ObjectType ?? "";

                        string assignedOfficer =
                        string.IsNullOrWhiteSpace(
                        detection.AssignedOfficer
                        )
                        ? "Unassigned"
                        : detection.AssignedOfficer;

                        string objectIcon =
                        objectType switch
                        {
                            "Person" => "●",
                            "Vehicle" => "◆",
                            "Package" => "■",
                            _ => "○"
                        };

                        string officerInitials =
                        assignedOfficer == "Unassigned"
                        ? "?"
                        : string.Concat(
                        assignedOfficer
                        .Split(
                        ' ',
                        StringSplitOptions
                        .RemoveEmptyEntries
                        )
                        .Take(2)
                        .Select(name => name[0])
                        );

                        string confidenceCss =
                        detection.Confidence.ToString(
                        "0.0",
                        CultureInfo.InvariantCulture
                        );

                        <tr class="detection-log-row"
                            data-id="@detection.DetectionId"
                            data-camera="@cameraName.ToLowerInvariant()"
                            data-object="@objectType.ToLowerInvariant()"
                            data-severity="@severityClass"
                            data-status="@statusClass"
                            data-date="@detection.DetectedAt.ToString("O")"
                            data-tracking-id="@detection.TrackingId"
                            data-frame-id="@detection.FrameId"
                            data-camera-name="@detection.CameraName"
                            data-camera-code="@detection.CameraCode"
                            data-location="@detection.Location"
                            data-zone="@detection.Zone"
                            data-object-type="@detection.ObjectType"
                            data-confidence="@confidenceCss"
                            data-alert-type="@detection.AlertType"
                            data-severity-name="@severity"
                            data-status-name="@status"
                            data-officer="@assignedOfficer"
                            data-detected-at="@detection.DetectedAt.ToString("dd MMM yyyy, hh:mm tt")"
                            data-notes="@detection.Notes"
                            data-ai-model="@detection.AiModel"
                            data-processing-time="@detection.ProcessingTimeMs.ToString("0.0", CultureInfo.InvariantCulture)"
                            data-box-count="@detection.BoundingBoxCount">

                            <td>

                                <div class="detection-id-cell">

                                    <div class="detection-thumbnail">

                                        <span>@objectIcon</span>

                                        <div class="scan-line"></div>

                                    </div>

                                    <div>

                                        <strong>
                                            DET-@detection.DetectionId
                                        </strong>

                                        <small>
                                            @detection.AlertType
                                        </small>

                                    </div>

                                </div>

                            </td>

                            <td>

                                <div class="camera-location-cell">

                                    <strong>
                                        @detection.CameraName
                                    </strong>

                                    <small>
                                        @detection.CameraCode ·
                                        @detection.Location
                                    </small>

                                </div>

                            </td>

                            <td>

                                <span class="object-type-badge">
                                    @detection.ObjectType
                                </span>

                            </td>

                            <td>

                                <div class="confidence-cell">

                                    <div class="confidence-header">

                                        <strong>
                                            @detection.Confidence.ToString("0.0")%
                                        </strong>

                                        <small>
                                            @detection.ProcessingTimeMs.ToString("0.0") ms
                                        </small>

                                    </div>

                                    <div class="confidence-track">

                                        <div class="confidence-fill"
                                             style="width: @confidenceCss%">
                                        </div>

                                    </div>

                                </div>

                            </td>

                            <td>

                                <span class="severity-badge severity-@severityClass">

                                    <span class="badge-dot"></span>

                                    @severity

                                </span>

                            </td>

                            <td>

                                <span class="status-badge status-@statusClass">
                                    @status
                                </span>

                            </td>

                            <td>

                                <div class="camera-location-cell">

                                    <strong>
                                        @detection.AiModel
                                    </strong>

                                    <small>
                                        @detection.BoundingBoxCount boxes
                                    </small>

                                </div>

                            </td>

                            <td>

                                <div class="officer-cell">

                                    <span class="officer-avatar">
                                        @officerInitials
                                    </span>

                                    <span>
                                        @assignedOfficer
                                    </span>

                                </div>

                            </td>

                            <td>

                                <div class="detected-time-cell">

                                    <strong>
                                        @detection.DetectedAt.ToString("hh:mm tt")
                                    </strong>

                                    <small>
                                        @detection.DetectedAt.ToString("dd MMM yyyy")
                                    </small>

                                </div>

                            </td>

                            <td>

                                <button type="button"
                                        class="view-detection-button"
                                        onclick="openDetectionModal(this)">
                                    View
                                </button>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

            <div id="emptyDetectionState"
                 class="empty-detection-state">

                <div class="empty-state-icon">
                    ⌕
                </div>

                <h3>No detections found</h3>

                <p>
                    Try changing your search or selected filters.
                </p>

                <button type="button"
                        class="secondary-action-button"
                        onclick="clearDetectionFilters()">
                    Clear all filters
                </button>

            </div>

        </div>

        <div class="logs-pagination">

            <div class="pagination-information">

                Showing

                <strong id="paginationStart">
                    0
                </strong>

                to

                <strong id="paginationEnd">
                    0
                </strong>

                of

                <strong id="paginationTotal">
                    @totalCount
                </strong>

                records

            </div>

            <div class="pagination-controls">

                <button type="button"
                        id="previousPageButton"
                        class="pagination-button"
                        onclick="changeDetectionPage(-1)">
                    Previous
                </button>

                <div id="pageNumberButtons"
                     class="page-number-buttons">
                </div>

                <button type="button"
                        id="nextPageButton"
                        class="pagination-button"
                        onclick="changeDetectionPage(1)">
                    Next
                </button>

            </div>

        </div>

    </section>

</section>

