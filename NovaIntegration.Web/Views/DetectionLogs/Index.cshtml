<script>
    const rowsPerPage = 10;

    let currentPage = 1;
    let filteredRows = [];
    let selectedDetectionRow = null;

    document.addEventListener(
        "DOMContentLoaded",
        function () {
            applyDetectionFilters();

            document.addEventListener(
                "keydown",
                function (event) {
                    if (event.key === "Escape") {
                        closeDetectionModal();
                    }
                }
            );
        }
    );

    function applyDetectionFilters() {
        const searchValue =
            document
                .getElementById("detectionSearch")
                .value
                .toLowerCase()
                .trim();

        const cameraValue =
            document
                .getElementById("cameraFilter")
                .value;

        const objectValue =
            document
                .getElementById("objectFilter")
                .value;

        const severityValue =
            document
                .getElementById("severityFilter")
                .value;

        const statusValue =
            document
                .getElementById("statusFilter")
                .value;

        const dateValue =
            document
                .getElementById("dateFilter")
                .value;

        const allRows =
            Array.from(
                document.querySelectorAll(
                    ".detection-log-row"
                )
            );

        const now = new Date();

        filteredRows =
            allRows.filter(
                function (row) {
                    const rowText =
                        row.innerText.toLowerCase();

                    const matchesSearch =
                        searchValue === "" ||
                        rowText.includes(
                            searchValue
                        );

                    const matchesCamera =
                        cameraValue === "" ||
                        row.dataset.camera ===
                            cameraValue;

                    const matchesObject =
                        objectValue === "" ||
                        row.dataset.object ===
                            objectValue;

                    const matchesSeverity =
                        severityValue === "" ||
                        row.dataset.severity ===
                            severityValue;

                    const matchesStatus =
                        statusValue === "" ||
                        row.dataset.status ===
                            statusValue;

                    const rowDate =
                        new Date(
                            row.dataset.date
                        );

                    let matchesDate = true;

                    if (dateValue === "today") {
                        matchesDate =
                            rowDate.toDateString() ===
                            now.toDateString();
                    }

                    if (dateValue === "24hours") {
                        const difference =
                            now.getTime() -
                            rowDate.getTime();

                        matchesDate =
                            difference >= 0 &&
                            difference <=
                                24 *
                                60 *
                                60 *
                                1000;
                    }

                    if (dateValue === "7days") {
                        const difference =
                            now.getTime() -
                            rowDate.getTime();

                        matchesDate =
                            difference >= 0 &&
                            difference <=
                                7 *
                                24 *
                                60 *
                                60 *
                                1000;
                    }

                    return (
                        matchesSearch &&
                        matchesCamera &&
                        matchesObject &&
                        matchesSeverity &&
                        matchesStatus &&
                        matchesDate
                    );
                }
            );

        currentPage = 1;

        updateDetectionTable();
    }

    function updateDetectionTable() {
        const allRows =
            Array.from(
                document.querySelectorAll(
                    ".detection-log-row"
                )
            );

        allRows.forEach(
            function (row) {
                row.style.display = "none";
            }
        );

        const startIndex =
            (currentPage - 1) *
            rowsPerPage;

        const endIndex =
            startIndex +
            rowsPerPage;

        const currentRows =
            filteredRows.slice(
                startIndex,
                endIndex
            );

        currentRows.forEach(
            function (row) {
                row.style.display = "";
            }
        );

        const totalRecords =
            filteredRows.length;

        document.getElementById(
            "visibleRecordCount"
        ).textContent =
            totalRecords;

        document.getElementById(
            "paginationStart"
        ).textContent =
            totalRecords === 0
                ? 0
                : startIndex + 1;

        document.getElementById(
            "paginationEnd"
        ).textContent =
            Math.min(
                endIndex,
                totalRecords
            );

        document.getElementById(
            "paginationTotal"
        ).textContent =
            totalRecords;

        document.getElementById(
            "emptyDetectionState"
        ).style.display =
            totalRecords === 0
                ? "flex"
                : "none";

        document.getElementById(
            "detectionLogsTable"
        ).style.display =
            totalRecords === 0
                ? "none"
                : "table";

        updatePaginationButtons();
    }

    function updatePaginationButtons() {
        const pageCount =
            Math.max(
                1,
                Math.ceil(
                    filteredRows.length /
                    rowsPerPage
                )
            );

        if (currentPage > pageCount) {
            currentPage = pageCount;
        }

        const pageContainer =
            document.getElementById(
                "pageNumberButtons"
            );

        pageContainer.innerHTML = "";

        for (
            let pageNumber = 1;
            pageNumber <= pageCount;
            pageNumber++
        ) {
            const button =
                document.createElement(
                    "button"
                );

            button.type = "button";

            button.textContent =
                pageNumber;

            button.className =
                "page-number-button";

            if (
                pageNumber ===
                currentPage
            ) {
                button.classList.add(
                    "active"
                );
            }

            button.addEventListener(
                "click",
                function () {
                    currentPage =
                        pageNumber;

                    updateDetectionTable();
                }
            );

            pageContainer.appendChild(
                button
            );
        }

        document.getElementById(
            "previousPageButton"
        ).disabled =
            currentPage === 1;

        document.getElementById(
            "nextPageButton"
        ).disabled =
            currentPage === pageCount ||
            filteredRows.length === 0;
    }

    function changeDetectionPage(
        direction
    ) {
        const pageCount =
            Math.max(
                1,
                Math.ceil(
                    filteredRows.length /
                    rowsPerPage
                )
            );

        const requestedPage =
            currentPage +
            direction;

        if (
            requestedPage < 1 ||
            requestedPage > pageCount
        ) {
            return;
        }

        currentPage =
            requestedPage;

        updateDetectionTable();
    }

    function clearDetectionFilters() {
        document.getElementById(
            "detectionSearch"
        ).value = "";

        document.getElementById(
            "cameraFilter"
        ).value = "";

        document.getElementById(
            "objectFilter"
        ).value = "";

        document.getElementById(
            "severityFilter"
        ).value = "";

        document.getElementById(
            "statusFilter"
        ).value = "";

        document.getElementById(
            "dateFilter"
        ).value = "";

        applyDetectionFilters();

        showDetectionToast(
            "Detection filters cleared."
        );
    }

    function openDetectionModal(
        button
    ) {
        const row =
            button.closest(
                ".detection-log-row"
            );

        if (!row) {
            return;
        }

        selectedDetectionRow = row;

        document.getElementById(
            "modalDetectionTitle"
        ).textContent =
            "DET-" +
            row.dataset.id;

        document.getElementById(
            "modalDetectionId"
        ).textContent =
            "DET-" +
            row.dataset.id;

        document.getElementById(
            "modalTrackingId"
        ).textContent =
            row.dataset.trackingId ||
            "—";

        document.getElementById(
            "modalFrameId"
        ).textContent =
            row.dataset.frameId ||
            "—";

        document.getElementById(
            "modalObjectType"
        ).textContent =
            row.dataset.objectType ||
            "—";

        document.getElementById(
            "modalConfidence"
        ).textContent =
            (row.dataset.confidence ||
                "0") +
            "%";

        document.getElementById(
            "modalSeverity"
        ).textContent =
            row.dataset.severityName ||
            "—";

        document.getElementById(
            "modalCameraName"
        ).textContent =
            (row.dataset.cameraName ||
                "—") +
            " (" +
            (row.dataset.cameraCode ||
                "—") +
            ")";

        document.getElementById(
            "modalLocation"
        ).textContent =
            row.dataset.location ||
            "—";

        document.getElementById(
            "modalZone"
        ).textContent =
            row.dataset.zone ||
            "—";

        document.getElementById(
            "modalAiModel"
        ).textContent =
            row.dataset.aiModel ||
            "—";

        document.getElementById(
            "modalProcessingTime"
        ).textContent =
            (row.dataset.processingTime ||
                "0") +
            " ms";

        document.getElementById(
            "modalBoxCount"
        ).textContent =
            row.dataset.boxCount ||
            "0";

        document.getElementById(
            "modalDetectedAt"
        ).textContent =
            row.dataset.detectedAt ||
            "—";

        document.getElementById(
            "modalOfficer"
        ).textContent =
            row.dataset.officer ||
            "Unassigned";

        document.getElementById(
            "modalNotes"
        ).textContent =
            row.dataset.notes ||
            "No investigation notes recorded.";

        document.getElementById(
            "modalStatusSelect"
        ).value =
            row.dataset.statusName ||
            "Pending";

        document.getElementById(
            "previewObjectLabel"
        ).textContent =
            (
                row.dataset.objectType ||
                "OBJECT"
            ).toUpperCase() +
            " " +
            (
                row.dataset.confidence ||
                "0"
            ) +
            "%";

        document.getElementById(
            "previewCameraLabel"
        ).textContent =
            row.dataset.cameraCode ||
            "CAMERA";

        const modal =
            document.getElementById(
                "detectionDetailsModal"
            );

        modal.classList.add(
            "open"
        );

        modal.setAttribute(
            "aria-hidden",
            "false"
        );

        document.body.classList.add(
            "modal-open"
        );
    }

    function closeDetectionModal() {
        const modal =
            document.getElementById(
                "detectionDetailsModal"
            );

        modal.classList.remove(
            "open"
        );

        modal.setAttribute(
            "aria-hidden",
            "true"
        );

        document.body.classList.remove(
            "modal-open"
        );

        selectedDetectionRow = null;
    }

    function saveDetectionStatus() {
        if (!selectedDetectionRow) {
            return;
        }

        const selectedStatus =
            document.getElementById(
                "modalStatusSelect"
            ).value;

        selectedDetectionRow.dataset.status =
            selectedStatus.toLowerCase();

        selectedDetectionRow.dataset.statusName =
            selectedStatus;

        const statusBadge =
            selectedDetectionRow.querySelector(
                ".status-badge"
            );

        if (statusBadge) {
            statusBadge.textContent =
                selectedStatus;

            statusBadge.className =
                "status-badge status-" +
                selectedStatus.toLowerCase();
        }

        closeDetectionModal();

        applyDetectionFilters();

        showDetectionToast(
            "Detection status updated to " +
            selectedStatus +
            "."
        );
    }

    function refreshDetectionLogs() {
        document.getElementById(
            "lastSyncTime"
        ).textContent =
            new Date()
                .toLocaleTimeString();

        showDetectionToast(
            "Detection records refreshed successfully."
        );
    }

    function exportDetectionLogs() {
        const csvRows = [
            [
                "Detection ID",
                "Camera",
                "Location",
                "Object",
                "Confidence",
                "Severity",
                "Status",
                "AI Model",
                "Officer",
                "Detected At"
            ]
        ];

        filteredRows.forEach(
            function (row) {
                csvRows.push(
                    [
                        "DET-" +
                            row.dataset.id,
                        row.dataset.cameraName,
                        row.dataset.location,
                        row.dataset.objectType,
                        row.dataset.confidence +
                            "%",
                        row.dataset.severityName,
                        row.dataset.statusName,
                        row.dataset.aiModel,
                        row.dataset.officer,
                        row.dataset.detectedAt
                    ]
                );
            }
        );

        const csvContent =
            csvRows
                .map(
                    function (row) {
                        return row
                            .map(
                                function (value) {
                                    return (
                                        '"' +
                                        String(
                                            value ?? ""
                                        ).replaceAll(
                                            '"',
                                            '""'
                                        ) +
                                        '"'
                                    );
                                }
                            )
                            .join(",");
                    }
                )
                .join("\n");

        const blob =
            new Blob(
                [csvContent],
                {
                    type:
                        "text/csv;charset=utf-8;"
                }
            );

        const downloadUrl =
            URL.createObjectURL(
                blob
            );

        const downloadLink =
            document.createElement(
                "a"
            );

        downloadLink.href =
            downloadUrl;

        downloadLink.download =
            "NovaIntegration_Detection_Logs.csv";

        document.body.appendChild(
            downloadLink
        );

        downloadLink.click();

        downloadLink.remove();

        URL.revokeObjectURL(
            downloadUrl
        );

        showDetectionToast(
            filteredRows.length +
            " records exported."
        );
    }

    function showDetectionToast(
        message
    ) {
        const toast =
            document.getElementById(
                "detectionToast"
            );

        document.getElementById(
            "detectionToastMessage"
        ).textContent =
            message;

        toast.classList.add(
            "show"
        );

        window.setTimeout(
            function () {
                toast.classList.remove(
                    "show"
                );
            },
            3000
        );
    }
</script>