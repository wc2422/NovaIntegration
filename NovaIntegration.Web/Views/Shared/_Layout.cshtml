<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - NovaIntegration</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body>

    <div class="sidebar">

        <h2>NovaIntegration</h2>

        <a asp-controller="Dashboard" asp-action="Index">
            Dashboard
        </a>

        <a asp-controller="Cameras" asp-action="Index">
            Cameras
        </a>

        <a asp-controller="Alerts" asp-action="Index">
            Alerts
        </a>

        <a asp-controller="DetectionLogs" asp-action="Index">
            Detection Logs
        </a>

    </div>

    <div class="main-content">

        <header class="topbar">

            <h3>AI Assisted Security Dashboard</h3>

            <span>Administrator</span>

        </header>

        <div class="page-content">

            @RenderBody()

        </div>

    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>