                    CAMERA
                </span>

                <span id="modalCameraTime"
                      class="modal-camera-time">
                    @DateTime.Now.ToString("HH:mm:ss")
                </span>

                <div class="modal-camera-focus"></div>

                <div class="modal-camera-scan"></div>

            </div>

            <div class="camera-modal-details">

                <div class="camera-modal-detail">

                    <span>Location</span>

                    <strong id="modalCameraLocation">
                        -
                    </strong>

                </div>

                <div class="camera-modal-detail">

                    <span>IP address</span>

                    <strong id="modalCameraIp">
                        -
                    </strong>

                </div>

                <div class="camera-modal-detail">

                    <span>Stream type</span>

                    <strong id="modalCameraStream">
                        -
                    </strong>

                </div>

                <div class="camera-modal-detail">

                    <span>Status</span>

                    <strong id="modalCameraStatus">
                        -
                    </strong>

                </div>

                <div class="camera-modal-detail">

                    <span>Resolution</span>

                    <strong id="modalCameraResolution">
                        -
                    </strong>

                </div>

                <div class="camera-modal-detail">

                    <span>Frame rate</span>

                    <strong id="modalCameraFps">
                        -
                    </strong>

                </div>

                <div class="camera-modal-detail">

                    <span>AI analysis</span>

                    <strong>
                        YOLO ACTIVE
                    </strong>

                </div>

                <div class="camera-modal-detail">

                    <span>Connection</span>

                    <strong>
                        ENCRYPTED
                    </strong>

                </div>

            </div>

        </div>

    </div>

</div>

<script>
    document.addEventListener(
        "DOMContentLoaded",
        function () {
            updateCameraClock();

            window.setInterval(
                updateCameraClock,
                1000
            );
        }
    );

    function updateCameraClock() {
        const now = new Date();

        const systemClock =
            document.getElementById(
                "cameraSystemClock"
            );

        const modalClock =
            document.getElementById(
                "modalCameraTime"
            );

        const currentTime =
            now.toLocaleTimeString(
                [],
                {
                    hour12: false
                }
            );

        if (systemClock) {
            systemClock.textContent =
                currentTime;
        }

        if (modalClock) {
            modalClock.textContent =
                currentTime;
        }
    }

    function filterCameras() {
        const searchValue =
            document
                .getElementById(
                    "cameraSearchInput"
                )
                .value
                .trim()
                .toLowerCase();

        const statusValue =
            document
                .getElementById(
                    "cameraStatusFilter"
                )
                .value
                .toLowerCase();

        const streamValue =
            document
                .getElementById(
                    "cameraStreamFilter"
                )
                .value
                .toLowerCase();

        const cards =
            document.querySelectorAll(
                ".soc-camera-card"
            );

        cards.forEach(
            function (card) {
                const searchableText =
                    [
                        card.dataset.cameraName,
                        card.dataset.cameraLocation,
                        card.dataset.cameraIp
                    ]
                        .join(" ")
                        .toLowerCase();

                const matchesSearch =
                    searchableText.includes(
                        searchValue
                    );

                const matchesStatus =
                    statusValue === "all" ||
                    card.dataset.cameraStatus ===
                    statusValue;

                const matchesStream =
                    streamValue === "all" ||
                    card.dataset.cameraStream ===
                    streamValue;

                card.style.display =
                    matchesSearch &&
                    matchesStatus &&
                    matchesStream
                        ? ""
                        : "none";
            }
        );
    }

    function resetCameraFilters() {
        document.getElementById(
            "cameraSearchInput"
        ).value = "";

        document.getElementById(
            "cameraStatusFilter"
        ).value = "all";

        document.getElementById(
            "cameraStreamFilter"
        ).value = "all";

        filterCameras();

        showCameraToast(
            "Camera filters cleared."
        );
    }

    function refreshCameraNetwork() {
        const button =
            document.querySelector(
                ".camera-refresh-button"
            );

        button.disabled = true;
        button.textContent =
            "Scanning camera network...";

        window.setTimeout(
            function () {
                button.disabled = false;
                button.textContent =
                    "↻ Refresh camera network";

                showCameraToast(
                    "Camera network scan completed successfully."
                );
            },
            900
        );
    }

    function openCameraModal(
        name,
        location,
        ipAddress,
        streamType,
        status,
        resolution,
        fps
    ) {
        document.getElementById(
            "cameraModalTitle"
        ).textContent =
            name + " — Live Feed";

        document.getElementById(
            "modalCameraName"
        ).textContent =
            name.toUpperCase();

        document.getElementById(
            "modalCameraLocation"
        ).textContent =
            location;

        document.getElementById(
            "modalCameraIp"
        ).textContent =
            ipAddress;

        document.getElementById(
            "modalCameraStream"
        ).textContent =
            streamType;

        document.getElementById(
            "modalCameraStatus"
        ).textContent =
            status;

        document.getElementById(
            "modalCameraResolution"
        ).textContent =
            resolution;

        document.getElementById(
            "modalCameraFps"
        ).textContent =
            fps;

        document.getElementById(
            "cameraModalOverlay"
        ).classList.add("show");

        document.body.style.overflow =
            "hidden";
    }

    function closeCameraModal() {
        document.getElementById(
            "cameraModalOverlay"
        ).classList.remove("show");

        document.body.style.overflow =
            "";
    }

    function closeCameraModalFromOverlay(
        event
    ) {
        if (
            event.target.id ===
            "cameraModalOverlay"
        ) {
            closeCameraModal();
        }
    }

    function showCameraToast(message) {
        const toast =
            document.getElementById(
                "cameraToast"
            );

        document.getElementById(
            "cameraToastMessage"
        ).textContent =
            message;

        toast.classList.add("show");

        window.setTimeout(
            function () {
                toast.classList.remove(
                    "show"
                );
            },
            3000
        );
    }

    document.addEventListener(
        "keydown",
        function (event) {
            if (event.key === "Escape") {
                closeCameraModal();
            }
        }
    );
</script>