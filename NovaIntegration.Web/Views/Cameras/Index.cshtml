@model List<NovaIntegration.Web.Models.Camera>

@{
    ViewData["Title"] = "Cameras";

    int totalCameras = Model?.Count ?? 0;

    int onlineCameras =
        Model?.Count(camera =>
            camera.Status.Equals(
                "Online",
                StringComparison.OrdinalIgnoreCase
            )
        ) ?? 0;

    int offlineCameras =
        Model?.Count(camera =>
            camera.Status.Equals(
                "Offline",
                StringComparison.OrdinalIgnoreCase
            )
        ) ?? 0;

    int maintenanceCameras =
        Math.Max(
            totalCameras - onlineCameras - offlineCameras,
            0
        );

    double networkAvailability =
        totalCameras > 0
            ? onlineCameras * 100.0 / totalCameras
            : 0;
}

