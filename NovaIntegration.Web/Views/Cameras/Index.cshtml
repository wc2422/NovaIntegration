        background: rgba(15, 23, 42, 0.8);
        color: #7c91a7;
    }

    .camera-menu-button {
        width: 38px;
        font-size: 14px;
    }

        .camera-view-button:hover,
        .camera-details-button:hover,
        .camera-menu-button:hover {
            border-color: rgba(56, 189, 248, 0.48);
            transform: translateY(-2px);
            box-shadow: 0 10px 24px rgba(0, 0, 0, 0.25);
        }

    .camera-empty-state {
        grid-column: 1 / -1;
        padding: 70px 24px;
        border: 1px solid rgba(51, 65, 85, 0.48);
        border-radius: 16px;
        background: linear-gradient( 145deg, rgba(12, 21, 36, 0.96), rgba(6, 13, 24, 0.97) );
        text-align: center;
    }

    .camera-empty-icon {
        display: flex;
        width: 70px;
        height: 70px;
        margin: 0 auto;
        align-items: center;
        justify-content: center;
        border: 1px solid rgba(56, 189, 248, 0.24);
        border-radius: 50%;
        background: rgba(14, 165, 233, 0.06);
        color: #7dd3fc;
        font-size: 13px;
        font-weight: 900;
    }

    .camera-empty-state h2 {
        margin: 17px 0 0;
        color: #dbeafe;
        font-size: 17px;
    }

    .camera-empty-state p {
        margin: 8px 0 0;
        color: #53677e;
        font-size: 10px;
    }

    .camera-toast {
        position: fixed;
        right: 25px;
        bottom: 25px;
        z-index: 5000;
        display: flex;
        min-width: 310px;
        align-items: center;
        gap: 10px;
        padding: 13px 15px;
        border: 1px solid rgba(34, 197, 94, 0.28);
        border-radius: 10px;
        background: linear-gradient( 135deg, rgba(4, 47, 30, 0.96), rgba(6, 24, 30, 0.96) );
        color: #bbf7d0;
        font-size: 9px;
        box-shadow: 0 18px 45px rgba(0, 0, 0, 0.42);
        opacity: 0;
        transform: translateY(20px);
        pointer-events: none;
        transition: opacity 0.2s ease, transform 0.2s ease;
    }

        .camera-toast.show {
            opacity: 1;
            transform: translateY(0);
        }

    .camera-toast-icon {
        display: flex;
        width: 25px;
        height: 25px;
        flex: 0 0 auto;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: #22c55e;
        color: #ffffff;
        box-shadow: 0 0 12px rgba(34, 197, 94, 0.5);
    }

    .camera-modal-overlay {
        position: fixed;
        inset: 0;
        z-index: 6000;
        display: none;
        align-items: center;
        justify-content: center;
        padding: 20px;
        background: rgba(1, 6, 15, 0.84);
        backdrop-filter: blur(9px);
    }

        .camera-modal-overlay.show {
            display: flex;
        }

    .camera-modal {
        width: min(900px, 100%);
        max-height: 90vh;
        overflow-y: auto;
        border: 1px solid rgba(56, 189, 248, 0.22);
        border-radius: 16px;
        background: linear-gradient( 145deg, #0d1728, #070e19 );
        box-shadow: 0 30px 90px rgba(0, 0, 0, 0.62), 0 0 45px rgba(14, 165, 233, 0.06);
    }

    .camera-modal-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        padding: 18px 20px;
        border-bottom: 1px solid rgba(51, 65, 85, 0.45);
        background: linear-gradient( 90deg, rgba(14, 165, 233, 0.06), transparent );
    }

        .camera-modal-header span {
            display: block;
            margin-bottom: 4px;
            color: #38bdf8;
            font-size: 7px;
            font-weight: 900;
            letter-spacing: 1.2px;
        }

        .camera-modal-header h2 {
            margin: 0;
            color: #f1f5f9;
            font-size: 18px;
        }

    .camera-modal-close {
        width: 35px;
        height: 35px;
        border: 1px solid rgba(71, 85, 105, 0.55);
        border-radius: 8px;
        background: rgba(15, 23, 42, 0.82);
        color: #64748b;
        font-size: 17px;
        cursor: pointer;
    }

        .camera-modal-close:hover {
            border-color: rgba(244, 63, 94, 0.35);
            color: #fb7185;
        }

    .camera-modal-body {
        padding: 20px;
    }

    .modal-live-preview {
        position: relative;
        height: 360px;
        overflow: hidden;
        border: 1px solid rgba(56, 189, 248, 0.38);
        border-radius: 12px;
        background: radial-gradient( circle at 50% 55%, #20364f, #060d17 72% );
        box-shadow: inset 0 0 45px rgba(0, 0, 0, 0.55), 0 0 24px rgba(14, 165, 233, 0.06);
    }

        .modal-live-preview .soc-preview-grid {
            background-size: 35px 35px;
        }

    .modal-camera-title {
        position: absolute;
        top: 14px;
        left: 14px;
        z-index: 4;
        padding: 6px 9px;
        border-radius: 5px;
        background: rgba(3, 8, 16, 0.76);
        color: #7dd3fc;
        font-family: Consolas, monospace;
        font-size: 8px;
    }

    .modal-camera-time {
        position: absolute;
        top: 14px;
        right: 14px;
        z-index: 4;
        padding: 6px 9px;
        border-radius: 5px;
        background: rgba(3, 8, 16, 0.76);
        color: #94a3b8;
        font-family: Consolas, monospace;
        font-size: 8px;
    }

    .modal-camera-focus {
        position: absolute;
        top: 50%;
        left: 50%;
        z-index: 3;
        width: 150px;
        height: 180px;
        border: 1px solid #22d3ee;
        transform: translate(-50%, -50%);
        box-shadow: 0 0 20px rgba(34, 211, 238, 0.2);
    }

    .modal-camera-scan {
        position: absolute;
        right: 0;
        left: 0;
        z-index: 2;
        height: 1px;
        background: #22d3ee;
        box-shadow: 0 0 10px rgba(34, 211, 238, 0.9);
        animation: modalCameraScan 4s linear infinite;
    }

    @@keyframes modalCameraScan {
        0% {
            top: 20px;
        }

        50% {
            top: 340px;
        }

        100% {
            top: 20px;
        }
    }

    .camera-modal-details {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 10px;
        margin-top: 14px;
    }

    .camera-modal-detail {
        padding: 11px;
        border: 1px solid rgba(51, 65, 85, 0.42);
        border-radius: 8px;
        background: rgba(10, 19, 32, 0.78);
    }

        .camera-modal-detail span,
        .camera-modal-detail strong {
            display: block;
        }

        .camera-modal-detail span {
            color: #52677f;
            font-size: 7px;
            text-transform: uppercase;
        }

        .camera-modal-detail strong {
            margin-top: 5px;
            overflow: hidden;
            color: #cbd5e1;
            font-size: 9px;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

    @@media (max-width: 1250px) {
        .soc-camera-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .camera-summary-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 850px) {
        .camera-command-header {
            flex-direction: column;
        }

        .camera-header-actions {
            width: 100%;
        }

        .camera-controls {
            grid-template-columns: 1fr 1fr;
        }

        .camera-search-box {
            grid-column: span 2;
        }

        .camera-modal-details {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 650px) {
        .camera-summary-grid,
        .soc-camera-grid,
        .camera-controls {
            grid-template-columns: 1fr;
        }

        .camera-search-box {
            grid-column: span 1;
        }

        .camera-command-indicators {
            flex-direction: column;
            gap: 9px;
        }

        .soc-camera-actions {
            grid-template-columns: 1fr 1fr;
        }

        .camera-menu-button {
            grid-column: span 2;
            width: 100%;
        }

        .camera-modal-details {
            grid-template-columns: 1fr;
        }

        .modal-live-preview {
            height: 260px;
        }

        .camera-toast {
            right: 14px;
            bottom: 14px;
            left: 14px;
            min-width: 0;
        }
    }
</style>

<section class="soc-cameras-page">

    <header class="camera-command-header">

        <div class="camera-header-content">

            <span class="camera-page-eyebrow">
                NOVA VIDEO SURVEILLANCE NETWORK
            </span>

            <h1>Camera Command Centre</h1>

            <p>
                Monitor connected security cameras, live stream health,
                network availability and AI-assisted video analysis.
            </p>

            <div class="camera-command-indicators">

                <span class="camera-command-indicator">
                    <i class="indicator-green"></i>
                    Camera network connected
                </span>

                <span class="camera-command-indicator">
                    <i class="indicator-blue"></i>
                    AI video analytics active
                </span>

                <span class="camera-command-indicator">
                    <i class="indicator-purple"></i>
                    Secure RTSP communication
                </span>

            </div>

        </div>

        <div class="camera-header-actions">

            <div class="camera-system-clock">

                <span>CAMERA NETWORK TIME</span>

                <strong id="cameraSystemClock">
                    @DateTime.Now.ToString("HH:mm:ss")
                </strong>

                <small>
                    @DateTime.Now.ToString("dddd, dd MMM yyyy")
                </small>

            </div>

            <button type="button"
                    class="camera-refresh-button"
                    onclick="refreshCameraNetwork()">
                ↻ Refresh camera network
            </button>

        </div>

    </header>

    <section class="camera-summary-grid">

        <article class="camera-summary-card">

            <div class="camera-summary-top">

                <div class="camera-summary-icon summary-total-icon">
                    CAM
                </div>

                <span class="camera-summary-chip">
                    NETWORK
                </span>

            </div>

            <strong>@totalCameras</strong>

            <h3>Total cameras</h3>

            <p>
                All registered surveillance endpoints
            </p>

            <div class="camera-health-track">
                <div class="camera-health-fill"
                     style="width: 100%">
                </div>
            </div>

        </article>

        <article class="camera-summary-card">

            <div class="camera-summary-top">

                <div class="camera-summary-icon summary-online-icon">
                    ✓
                </div>

                <span class="camera-summary-chip">
                    ACTIVE
                </span>

            </div>

            <strong>@onlineCameras</strong>

            <h3>Online cameras</h3>

            <p>
                Currently transmitting live video
            </p>

            <div class="camera-health-track">
                <div class="camera-health-fill"
                     style="width: @networkAvailability.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)%">
                </div>
            </div>

        </article>

        <article class="camera-summary-card">

            <div class="camera-summary-top">

                <div class="camera-summary-icon summary-offline-icon">
                    !
                </div>

                <span class="camera-summary-chip">
                    REVIEW
                </span>

            </div>

            <strong>@offlineCameras</strong>

            <h3>Offline cameras</h3>

            <p>
                Cameras requiring connection review
            </p>

            <div class="camera-health-track">
                <div class="camera-health-fill"
                     style="width: @(offlineCameras > 0 ? "38" : "100")%">
                </div>
            </div>

        </article>

        <article class="camera-summary-card">

            <div class="camera-summary-top">

                <div class="camera-summary-icon summary-health-icon">
                    %
                </div>

                <span class="camera-summary-chip">
                    HEALTH
                </span>

            </div>

            <strong>
                @networkAvailability.ToString("0.0")%
            </strong>

            <h3>Network availability</h3>

            <p>
                @maintenanceCameras cameras currently under maintenance
            </p>

            <div class="camera-health-track">
                <div class="camera-health-fill"
                     style="width: @networkAvailability.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)%">
                </div>
            </div>

        </article>

    </section>

    <section class="camera-control-panel">

        <div class="camera-controls">

            <div class="camera-search-box">

                <span>⌕</span>

                <input id="cameraSearchInput"
                       type="text"
                       placeholder="Search camera, location or IP address..."
                       oninput="filterCameras()" />

            </div>

            <select id="cameraStatusFilter"
                    onchange="filterCameras()">

                <option value="all">
                    All statuses
                </option>

                <option value="online">
                    Online
                </option>

                <option value="offline">
                    Offline
                </option>

                <option value="maintenance">
                    Maintenance
                </option>

            </select>

            <select id="cameraStreamFilter"
                    onchange="filterCameras()">

                <option value="all">
                    All stream types
                </option>

                @foreach (
                                string streamType
                                in Model
                                .Select(camera => camera.StreamType)
                                .Where(streamType =>
                                !string.IsNullOrWhiteSpace(streamType)
                                )
                                .Distinct()
                                )
                {
                    <option value="@streamType.ToLower()">
                        @streamType
                    </option>
                }

            </select>

            <button type="button"
                    class="camera-layout-button"
                    onclick="resetCameraFilters()">
                Clear filters
            </button>

        </div>

    </section>

    <section id="cameraGrid"
             class="soc-camera-grid">

        @if (Model.Count == 0)
        {
            <div class="camera-empty-state">

                <div class="camera-empty-icon">
                    CAM
                </div>

                <h2>No cameras registered</h2>

                <p>
                    Camera endpoints will appear here after they are
                    connected to NovaIntegration.
                </p>

            </div>
        }
        else
        {
            int cameraIndex = 0;

            foreach (var camera in Model)
            {
                cameraIndex++;

                bool isOnline =
                camera.Status.Equals(
                "Online",
                StringComparison.OrdinalIgnoreCase
                );

                bool isOffline =
                camera.Status.Equals(
                "Offline",
                StringComparison.OrdinalIgnoreCase
                );

                string statusKey =
                isOnline
                ? "online"
                : isOffline
                ? "offline"
                : "maintenance";

                string statusClass =
                isOnline
                ? "soc-status-online"
                : isOffline
                ? "soc-status-offline"
                : "soc-status-maintenance";

                string previewClass =
                isOnline
                ? ""
                : isOffline
                ? "camera-preview-offline"
                : "camera-preview-maintenance";

                string cameraCode =
                $"CAM-{cameraIndex.ToString("000")}";

                string fps =
                isOnline
                ? $"{24 + cameraIndex % 7} FPS"
                : "0 FPS";

                string resolution =
                cameraIndex % 2 == 0
                ? "1920 × 1080"
                : "2560 × 1440";

                string signalStrength =
                isOnline
                ? $"{91 + cameraIndex % 8}%"
                : isOffline
                ? "0%"
                : "42%";

                <article class="soc-camera-card"
                         data-camera-name="@camera.CameraName.ToLower()"
                         data-camera-location="@camera.Location.ToLower()"
                         data-camera-ip="@camera.IpAddress.ToLower()"
                         data-camera-status="@statusKey"
                         data-camera-stream="@camera.StreamType.ToLower()">

                    <div class="soc-camera-preview @previewClass">

                        <div class="soc-preview-grid"></div>

                        <div class="soc-camera-topbar">

                            <span class="soc-camera-id">
                                @cameraCode
                            </span>

                            @if (isOnline)
                            {
                                <span class="soc-recording-label">
                                    <i></i>
                                    REC
                                </span>
                            }
                            else
                            {
                                <span class="soc-camera-id">
                                    NO SIGNAL
                                </span>
                            }

                        </div>

                        @if (isOnline)
                        {
                            <div class="soc-camera-focus"></div>

                            <div class="soc-camera-scan"></div>

                            <span class="soc-camera-detection-label">
                                AI TARGET ANALYSIS
                            </span>
                        }
                        else if (isOffline)
                        {
                            <div class="camera-offline-symbol">
                                OFFLINE
                            </div>
                        }
                        else
                        {
                            <div class="camera-maintenance-symbol">
                                SERVICE
                            </div>
                        }

                        <div class="soc-camera-bottom-overlay">

                            <span class="soc-camera-status @statusClass">
                                <i></i>
                                @camera.Status
                            </span>

                            <span class="camera-fps-label">
                                @fps
                            </span>

                        </div>

                    </div>

                    <div class="soc-camera-content">

                        <div class="soc-camera-heading">

                            <div>
                                <h2>@camera.CameraName</h2>

                                <p>@camera.Location</p>
                            </div>

                            <span class="camera-health-code">
                                @cameraCode
                            </span>

                        </div>

                        <div class="soc-camera-details">

                            <div class="soc-camera-detail">

                                <span>IP address</span>

                                <strong>
                                    @camera.IpAddress
                                </strong>

                            </div>

                            <div class="soc-camera-detail">

                                <span>Stream type</span>

                                <strong>
                                    @camera.StreamType
                                </strong>

                            </div>

                            <div class="soc-camera-detail">

                                <span>Resolution</span>

                                <strong>
                                    @resolution
                                </strong>

                            </div>

                            <div class="soc-camera-detail">

                                <span>Last activity</span>

                                <strong>
                                    @camera.LastActivity.ToString(
                                    "dd MMM, HH:mm"
                                                        )
                        </strong>

                    </div>

                </div>

                <div class="soc-camera-metrics">

                    <div class="camera-metric">

                        <strong>@fps</strong>

                        <span>Frame rate</span>

                    </div>

                    <div class="camera-metric">

                        <strong>@signalStrength</strong>

                        <span>Signal</span>

                    </div>

                    <div class="camera-metric">

                        <strong>
                            @(isOnline ? "ACTIVE" : "IDLE")
                        </strong>

                        <span>AI engine</span>

                    </div>

                </div>

                <div class="soc-camera-actions">

                    <button type="button"
                            class="camera-view-button"
                            onclick="openCameraModal(
                                        '@Html.Raw(
                                                                        System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(
                                                                            camera.CameraName
                                                                        )
                                                                    )',
                                        '@Html.Raw(
                                                                        System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(
                                                                            camera.Location
                                                                        )
                                                                    )',
                                        '@Html.Raw(
                                                                        System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(
                                                                            camera.IpAddress
                                                                        )
                                                                    )',
                                        '@Html.Raw(
                                                                        System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(
                                                                            camera.StreamType
                                                                        )
                                                                    )',
                                        '@Html.Raw(
                                                                        System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(
                                                                            camera.Status
                                                                        )
                                                                    )',
                                        '@resolution',
                                        '@fps'
                                    )">
                        View live feed
                    </button>

                            <button type="button"
                                    class="camera-details-button"
                                    onclick="showCameraToast(
                                                '@Html.Raw(
                                                                        System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(
                                                                            camera.CameraName
                                                                        )
                                                                    ) details loaded successfully.'
                                    )">
                        Diagnostics
                    </button>

                            <button type="button"
                                    class="camera-menu-button"
                                    onclick="showCameraToast(
                                                'Camera command menu opened.'
                                            )">
                                ⋮
                            </button>

                        </div>

                    </div>

                </article>
                }
        }

    </section>

</section>

<div id="cameraToast"
     class="camera-toast">

    <span class="camera-toast-icon">
        ✓
    </span>

    <strong id="cameraToastMessage">
        Camera network refreshed successfully.
    </strong>

</div>

<div id="cameraModalOverlay"
     class="camera-modal-overlay"
     onclick="closeCameraModalFromOverlay(event)">

    <div class="camera-modal">

        <header class="camera-modal-header">

            <div>

                <span>
                    LIVE CAMERA INVESTIGATION
                </span>

                <h2 id="cameraModalTitle">
                    Camera feed
                </h2>

            </div>

            <button type="button"
                    class="camera-modal-close"
