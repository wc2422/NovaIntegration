@model NovaIntegration.Web.Models.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";

    int offlineCameras =
        Math.Max(
            Model.TotalCameras - Model.ActiveCameras,
            0
        );

    double cameraAvailability =
        Model.TotalCameras > 0
            ? Model.ActiveCameras * 100.0 / Model.TotalCameras
            : 0;

    int chartMaxValue = Model.ActivityPoints
        .Select(point => Math.Max(point.Detections, Math.Max(point.Alerts, point.HighConfidence)))
        .DefaultIfEmpty(0)
        .Max();
    int chartScale = Math.Max(10, (int)(Math.Ceiling(chartMaxValue / 10.0) * 10));
}

<section class="soc-dashboard-page">

    <header class="soc-dashboard-hero">

        <div class="dashboard-hero-content">

            <span class="dashboard-eyebrow">
                NOVA SECURITY OPERATIONS CENTRE
            </span>

            <h1>Security Intelligence Dashboard</h1>

            <p>
                Database-backed overview of camera status, AI detections,
                recorded events and available system health data.
            </p>

            <div class="dashboard-command-status">

                <span class="command-status-item">
                    <i class="status-light @(Model.DatabaseConnected ? "status-online" : "status-offline")"></i>
                    @Model.SystemStatus
                </span>

                <span class="command-status-item">
                    <i class="status-light @(Model.DatabaseConnected ? "status-online" : "status-offline")"></i>
                    @Model.TotalCameras cameras in database
                </span>

                <span class="command-status-item">
                    <i class="status-light @(Model.DatabaseConnected ? "status-online" : "status-offline")"></i>
                    @Model.DetectionsToday detections today
                </span>

            </div>

        </div>

        <div class="dashboard-hero-actions">

            <div class="dashboard-system-clock">
                <span>LOCAL SYSTEM TIME</span>
                <strong id="dashboardSystemClock">
                    @DateTime.Now.ToString("HH:mm:ss")
                </strong>
                <small>
                    @DateTime.Now.ToString("dddd, dd MMM yyyy")
                </small>
            </div>

            <button type="button"
                    class="dashboard-refresh-button"
                    onclick="refreshDashboard()">
                <span>↻</span>
                Refresh intelligence
            </button>

        </div>

    </header>

    <section class="dashboard-kpi-grid">

        <article class="dashboard-kpi-card kpi-cameras">

            <div class="kpi-card-top">

                <div class="kpi-icon">
                    ◉
                </div>

                <span class="kpi-live-label">
                    @(Model.DatabaseConnected ? "DATABASE" : "NO DATA")
                </span>

            </div>

            <div class="kpi-card-value">
                @Model.TotalCameras
            </div>

            <div class="kpi-card-title">
                Total cameras
            </div>

            <div class="kpi-card-footer">

                <span>
                    @Model.ActiveCameras active
                </span>

                <strong>
                    @offlineCameras not active
                </strong>

            </div>

            <div class="kpi-progress-track">
                <div class="kpi-progress-fill"
                     style="width: @cameraAvailability.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)%">
                </div>
            </div>

        </article>

        <article class="dashboard-kpi-card kpi-active">

            <div class="kpi-card-top">

                <div class="kpi-icon">
                    ✓
                </div>

                <span class="@(Model.DatabaseConnected ? "kpi-status-positive" : "kpi-status-warning")">
                    @(Model.DatabaseConnected ? "DATABASE" : "NO DATA")
                </span>

            </div>

            <div class="kpi-card-value">
                @Model.ActiveCameras
            </div>

            <div class="kpi-card-title">
                Active cameras in database
            </div>

            <div class="kpi-card-footer">

                <span>
                    Camera availability
                </span>

                <strong>
                    @cameraAvailability.ToString("0.0")%
                </strong>

            </div>

            <div class="kpi-progress-track">
                <div class="kpi-progress-fill"
                     style="width: @cameraAvailability.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)%">
                </div>
            </div>

        </article>

        <article class="dashboard-kpi-card kpi-alerts">

            <div class="kpi-card-top">

                <div class="kpi-icon">
                    !
                </div>

                <span class="kpi-status-warning">
                    @(Model.DatabaseConnected ? "DATABASE" : "NO DATA")
                </span>

            </div>

            <div class="kpi-card-value">
                @Model.AlertsToday
            </div>

            <div class="kpi-card-title">
                Alerts today
            </div>

            <div class="kpi-card-footer">

                <span>
                    Event types today
                </span>

                <strong>
                    @Model.EventTypeCounts.Count
                </strong>

            </div>

        </article>

        <article class="dashboard-kpi-card kpi-detections">

            <div class="kpi-card-top">

                <div class="kpi-icon">
                    ◎
                </div>

                <span class="kpi-status-ai">
                    @(Model.DatabaseConnected ? "DATABASE" : "NO DATA")
                </span>

            </div>

            <div class="kpi-card-value">
                @Model.DetectionsToday
            </div>

            <div class="kpi-card-title">
                AI detections today
            </div>

            <div class="kpi-card-footer">

                <span>
                    Average confidence
                </span>

                <strong>
                    @Model.AverageConfidence.ToString("0.0")%
                </strong>

            </div>

            <div class="kpi-progress-track">
                <div class="kpi-progress-fill"
                     style="width: @Model.AverageConfidence.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)%">
                </div>
            </div>

        </article>

    </section>

    <section class="dashboard-command-grid">

        <article class="dashboard-panel dashboard-activity-panel">

            <div class="dashboard-panel-header">

                <div>
                    <span class="dashboard-panel-eyebrow">
                        THREAT INTELLIGENCE
                    </span>

                    <h2>Detection Activity</h2>
                </div>

                <select asp-for="RangeHours" id="dashboardActivityRange"
                        onchange="window.location.href='?rangeHours=' + this.value">
                    <option value="12">Last 12 hours</option>
                    <option value="24">Last 24 hours</option>
                    <option value="48">Last 48 hours</option>
                </select>

            </div>

            <div class="dashboard-chart-layout">

                <div class="dashboard-chart-scale">
                    <span>@chartScale</span>
                    <span>@(chartScale * 2 / 3)</span>
                    <span>@(chartScale / 3)</span>
                    <span>0</span>
                </div>

                <div id="dashboardActivityChart"
                     class="dashboard-activity-chart">
                    @foreach (var point in Model.ActivityPoints)
                    {
                        <div class="dashboard-chart-bar-group" title="@point.Hour.ToString("yyyy-MM-dd HH:00")">
                            <div class="dashboard-chart-bars">
                                <div class="dashboard-chart-bar dashboard-detection-bar"
                                     style="height: @(point.Detections * 100.0 / chartScale).ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)%"></div>
                                <div class="dashboard-chart-bar dashboard-alert-bar"
                                     style="height: @(point.Alerts * 100.0 / chartScale).ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)%"></div>
                                <div class="dashboard-chart-bar dashboard-critical-bar"
                                     style="height: @(point.HighConfidence * 100.0 / chartScale).ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)%"></div>
                            </div>
                            <span>@point.Label</span>
                        </div>
                    }
                </div>

            </div>

            <div class="dashboard-chart-legend">

                <span>
                    <i class="legend-mark detection-mark"></i>
                    Detections
                </span>

                <span>
                    <i class="legend-mark alert-mark"></i>
                    Alerts
                </span>

                <span>
                    <i class="legend-mark critical-mark"></i>
                    High confidence (90%+)
                </span>

            </div>

        </article>

        <article class="dashboard-panel dashboard-threat-panel">

            <div class="dashboard-panel-header">

                <div>
                    <span class="dashboard-panel-eyebrow">
                        DATABASE EVENTS TODAY
                    </span>

                    <h2>Event Types</h2>
                </div>

                    <span class="dashboard-live-chip">
                    @(Model.DatabaseConnected ? "DATABASE" : "NO DATA")
                </span>

            </div>

            <div class="dashboard-threat-layout">

                <div class="dashboard-threat-radar">

                    <div class="radar-ring radar-ring-one"></div>
                    <div class="radar-ring radar-ring-two"></div>
                    <div class="radar-ring radar-ring-three"></div>

                    <div class="radar-cross radar-cross-horizontal"></div>
                    <div class="radar-cross radar-cross-vertical"></div>

                    <div class="radar-centre">
                        <strong>@Model.AlertsToday</strong>
                        <small>ALERTS TODAY</small>
                    </div>

                </div>

                <div class="dashboard-threat-list">
                    @if (Model.EventTypeCounts.Count > 0)
                    {
                        foreach (var eventType in Model.EventTypeCounts)
                        {
                            <div>
                                <span>@eventType.EventType</span>
                                <strong>@eventType.Count</strong>
                            </div>
                        }
                    }
                    else
                    {
                        <div><span>No event types</span><strong>0</strong></div>
                    }
                </div>

            </div>

        </article>

        <article class="dashboard-panel dashboard-health-panel">

            <div class="dashboard-panel-header">

                <div>
                    <span class="dashboard-panel-eyebrow">
                        INFRASTRUCTURE
                    </span>

                    <h2>System Health</h2>
                </div>

                <span class="dashboard-health-percent @(Model.DatabaseConnected ? "" : "dashboard-health-unavailable")">
                    @Model.SystemStatus
                </span>

            </div>

            <div class="dashboard-health-list">

                <div class="health-row">

                    <div class="health-row-heading">
                        <span>Camera network</span>
                        <strong>@cameraAvailability.ToString("0")%</strong>
                    </div>

                    <div class="health-track">
                        <div class="health-fill"
                             style="width: @cameraAvailability.ToString("0", System.Globalization.CultureInfo.InvariantCulture)%">
                        </div>
                    </div>

                </div>

                <div class="health-row">

                    <div class="health-row-heading">
                        <span>AI health telemetry records</span>
                        <strong>0</strong>
                    </div>

                    <div class="health-track">
                        <div class="health-fill"
                             style="width: 0%">
                        </div>
                    </div>

                </div>

                <div class="health-row">

                    <div class="health-row-heading">
                        <span>Database connection</span>
                        <strong>@Model.DatabaseAvailability.ToString("0")%</strong>
                    </div>

                    <div class="health-track">
                        <div class="health-fill"
                             style="width: @Model.DatabaseAvailability.ToString("0", System.Globalization.CultureInfo.InvariantCulture)%">
                        </div>
                    </div>

                </div>

                <div class="health-row">

                    <div class="health-row-heading">
                        <span>Alert delivery telemetry records</span>
                        <strong>0</strong>
                    </div>

                    <div class="health-track">
                        <div class="health-fill"
                             style="width: 0%">
                        </div>
                    </div>

                </div>

            </div>

            <div class="dashboard-health-footer">

                <span>
                    <i></i>
                    @Model.SystemStatus
                </span>

                <small>
                    Checked
                    <span id="dashboardHealthTime">
                        @Model.LastCheckedAt.ToString("HH:mm:ss")
                    </span>
                </small>

            </div>

        </article>

    </section>

    <section class="dashboard-secondary-grid">

        <article class="dashboard-panel dashboard-alerts-panel">

            <div class="dashboard-panel-header">

                <div>
                    <span class="dashboard-panel-eyebrow">
                        INCIDENT MONITORING
                    </span>

                    <h2>Recent Events</h2>
                </div>

                <a asp-controller="Alerts"
                   asp-action="Index"
                   class="dashboard-panel-link">
                    View all alerts
                </a>

            </div>

            <div class="dashboard-alert-list">

                @foreach (var alert in Model.RecentAlerts.Take(6))
                {
                    string severityClass =
                    alert.Severity.ToLower();

                    string objectSymbol =
                    alert.ObjectType switch
                    {
                        "Person" => "●",
                        "Vehicle" => "◆",
                        "Package" => "■",
                        _ => "○"
                    };

                    <div class="dashboard-alert-item">

                        <div class="dashboard-alert-icon alert-icon-@severityClass">
                            @objectSymbol
                        </div>

                        <div class="dashboard-alert-information">

                            <div class="dashboard-alert-title">
                                <strong>
                                    @alert.ObjectType detected
                                </strong>

                                <span class="dashboard-severity-badge severity-@severityClass">
                                    @alert.Severity
                                </span>
                            </div>

                            <small>
                                @alert.CameraName
                            </small>

                        </div>

                        <div class="dashboard-confidence">

                            <strong>
                                @alert.Confidence.ToString("0.0")%
                            </strong>

                            <div class="confidence-mini-track">
                                <div class="confidence-mini-fill"
                                     style="width: @alert.Confidence.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)%">
                                </div>
                            </div>

                        </div>

                    </div>
                }
                @if (Model.RecentAlerts.Count == 0)
                {
                    <div class="dashboard-empty-state">
                        @(Model.DatabaseConnected ? "No events recorded." : "Database unavailable. 0 events loaded.")
                    </div>
                }

            </div>

        </article>

        <article class="dashboard-panel dashboard-camera-panel">

            <div class="dashboard-panel-header">

                <div>
                    <span class="dashboard-panel-eyebrow">
                        CAMERA INFRASTRUCTURE
                    </span>

                    <h2>Camera Network</h2>
                </div>

                <a asp-controller="Cameras"
                   asp-action="Index"
                   class="dashboard-panel-link">
                    Open cameras
                </a>

            </div>

            <div class="dashboard-camera-grid">

                @foreach (var camera in Model.CameraStatuses.Take(6))
                {
                    bool isOnline =
                    camera.Status.Equals(
                    "Online",
                    StringComparison.OrdinalIgnoreCase
                    ) ||
                    camera.Status.Equals(
                    "Active",
                    StringComparison.OrdinalIgnoreCase
                    );

                    string statusClass =
                    isOnline
                    ? "online"
                    : "offline";

                    <div class="dashboard-camera-card">

                        <div class="camera-preview-screen">

                            <div class="camera-preview-grid"></div>

                            <div class="camera-preview-status">
                                <span class="camera-status-dot camera-@statusClass"></span>

                                @camera.Status
                            </div>

                            <span class="camera-preview-code">
                                DATABASE STATUS
                            </span>

                            <div class="camera-preview-label">
                                STATUS ONLY
                            </div>

                        </div>

                        <div class="camera-card-details">

                            <div>
                                <strong>
                                    @camera.CameraName
                                </strong>

                                <small>
                                    @camera.Location
                                </small>
                            </div>

                            <span class="camera-status-label camera-label-@statusClass">
                                @camera.Status
                            </span>

                        </div>

                    </div>
                }
                @if (Model.CameraStatuses.Count == 0)
                {
                    <div class="dashboard-empty-state">
                        @(Model.DatabaseConnected ? "No cameras found in the database." : "Database unavailable. 0 cameras loaded.")
                    </div>
                }

            </div>

        </article>

        <article class="dashboard-panel dashboard-activity-feed-panel">

            <div class="dashboard-panel-header">

                <div>
                    <span class="dashboard-panel-eyebrow">
                    DATABASE ACTIVITY
                    </span>

                    <h2>System Activity</h2>
                </div>

                <span class="activity-connected-label">
                    <i></i>
                    @Model.SystemStatus
                </span>

            </div>

            <div id="dashboardLiveFeed"
                 class="dashboard-live-feed">

                @if (Model.RecentAlerts != null && Model.RecentAlerts.Count > 0)
                {
                    foreach (var alert in Model.RecentAlerts)
                    {
                        <div class="dashboard-feed-item">
                            <span class="feed-line feed-blue"></span>
                            <div>
                                <strong>@alert.ObjectType detected (@alert.Severity)</strong>
                                <small>@alert.CameraName - Confidence: @alert.Confidence%</small>
                            </div>
                            <time>
                                @alert.DetectedAt.ToString("HH:mm:ss")
                            </time>
                        </div>
                    }
                }
                else
                {
                    <div class="dashboard-feed-item">
                        <span class="feed-line feed-blue"></span>
                        <div>
                            <strong>@(Model.DatabaseConnected ? "No events recorded" : "Database unavailable")</strong>
                            <small>0 events loaded</small>
                        </div>
                        <time>@Model.LastCheckedAt.ToString("HH:mm:ss")</time>
                    </div>
                }

            </div>

        </article>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        updateDashboardClock();
        window.setInterval(updateDashboardClock, 1000);
    });

    function updateDashboardClock() {
        const now = new Date();

        const clock =
            document.getElementById(
                "dashboardSystemClock"
            );

        if (clock) {
            clock.textContent =
                now.toLocaleTimeString([], {
                    hour12: false
                });
        }
    }

    function refreshDashboard() {
        window.location.reload();
    }
</script>
